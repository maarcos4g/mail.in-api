generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Plan {
  id           String @id @default(uuid())
  name         String
  priceInCents Int    @default(0) @map("price_in_cents")
  description  String

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @unique @map("updated_at")

  users User[]

  @@map("plans")
}

model User {
  id          String  @id @default(uuid())
  fullName    String  @map("full_name")
  firstName   String  @map("first_name")
  email       String  @unique
  avatarUrl   String? @map("avatar_url")
  isConfirmed Boolean @default(false) @map("is_confirmed")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  plan   Plan   @relation(fields: [planId], references: [id])
  planId String

  authCodes      AuthCode[]
  teamMembership TeamMembership[]
  invites        Invite[]

  @@map("users")
}

model AuthCode {
  id   String @id @default(cuid())
  code String @unique

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  expiredAt DateTime? @map("expired_at")

  user   User   @relation(fields: [userId], references: [id])
  userId String

  @@map("auth_codes")
}

model Team {
  id   String @id @default(uuid())
  name String
  slug String @unique

  ownerId String @map("owner_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  teamMembership TeamMembership[]
  emailLists     EmailList[]
  invites        Invite[]
  activities     Activity[]

  @@map("teams")
}

model TeamMembership {
  id     String @id @default(uuid())
  userId String
  teamId String

  hasInvite    Boolean? @default(false)
  invitationId String?

  user User @relation(fields: [userId], references: [id])
  team Team @relation(fields: [teamId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, teamId])
  @@map("team_membership")
}

model EmailList {
  id      String   @id @default(uuid())
  name    String
  senders String[]

  ownerId String @map("owner_id")

  team   Team   @relation(fields: [teamId], references: [id])
  teamId String

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  emails Email[]

  @@map("email_list")
}

model Invite {
  id         String  @id @default(cuid())
  guestId    String? @map("guest_id")
  guestEmail String  @map("guest_email")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  team   Team?   @relation(fields: [teamId], references: [id])
  teamId String? @map("team_id")

  inviter   User?   @relation(fields: [inviterId], references: [id])
  inviterId String? @map("inviter_id")

  hasAccepted Boolean @default(false) @map("has_accepted")

  @@map("invites")
}

model Activity {
  id String @id @default(cuid())

  authorName String @map("author_name")
  authorId   String @map("author_id")

  type    ActivityType
  subtype ActivitySubtype?

  team   Team   @relation(fields: [teamId], references: [id])
  teamId String @map("team_id")

  createdAt DateTime @default(now()) @map("created_at")

  @@map("activities")
}

enum ActivityType {
  MEMBERSHIP
  CREATE
}

enum ActivitySubtype {
  EMAILLIST
  EMAIL
}

model Email {
  id      String      @id @default(cuid())
  title   String
  subject String
  content String
  status  EmailStatus @default(DRAFT)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  sentAt    DateTime? @map("sent_at")

  emailList   EmailList @relation(fields: [emailListId], references: [id])
  emailListId String    @map("email_list")

  @@map("emails")
}

enum EmailStatus {
  DRAFT
  QUEUE
  SENT
}
